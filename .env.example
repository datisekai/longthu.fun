# Backend
DATABASE_URL="mysql://longthu:longthu@localhost:3306/longthu?parseTime=true&loc=Asia%2FHo_Chi_Minh"
JWT_SECRET="generate-with-openssl-rand-hex-32"
SECRETS_MASTER_KEY="generate-with-openssl-rand-hex-32"
APP_BASE_URL="http://localhost:5173"
GIT_SHA="dev"

# payOS (per Host; configured via Auto-Detect setup wizard later — placeholders here)
PAYOS_CLIENT_ID=""
PAYOS_API_KEY=""
PAYOS_CHECKSUM_KEY=""

# Telegram Platform Bot (single bot operated by Longthu.fun)
TELEGRAM_BOT_TOKEN=""

# Admin tool (Story 5.3 — billing flip + manual password reset)
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""

# MySQL (used by docker-compose only — service-internal)
MYSQL_ROOT_PASSWORD="rootpw"
MYSQL_DATABASE="longthu"
MYSQL_USER="longthu"
MYSQL_PASSWORD="longthu"

# Frontend (Rsbuild reads RSBUILD_PUBLIC_* env vars)
RSBUILD_PUBLIC_API_BASE_URL="http://localhost:8080"
