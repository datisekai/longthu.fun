# =============================================
# Longthu.fun - Environment Variables
# =============================================
# Copy this file to .env and fill in your values

# Server
PORT=8080
APP_BASE_URL=http://localhost:5173

# Database (MySQL)
# Format: mysql://user:password@host:port/database
DATABASE_URL=mysql://root:password@localhost:3306/longthufun

# JWT Authentication (generate with: openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-here-generate-with-openssl-rand-hex-32

# Secrets Master Key for encrypting payOS credentials (generate with: openssl rand -hex 32)
SECRETS_MASTER_KEY=your-master-key-here-generate-with-openssl-rand-hex-32

# =============================================
# payOS Configuration (required for Auto-Detect)
# =============================================
# Get these from https://my.payos.vn
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key

# =============================================
# Production Notes
# =============================================
# For production deployment:
# 1. Set APP_BASE_URL to your production domain (e.g., https://longthu.fun)
# 2. Use strong, randomly generated secrets
# 3. Never commit .env to version control
# 4. Consider using a secret manager in production
